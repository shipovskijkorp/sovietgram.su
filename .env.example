# Local development defaults
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# sqlite is used locally. Change to postgresql on the VPS.
DB_ENGINE=sqlite
POSTGRES_DB=sovietgram
POSTGRES_USER=sovietgram
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Local development defaults
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# sqlite is used locally. Change to postgresql on the VPS.
DB_ENGINE=sqlite
POSTGRES_DB=sovietgram
POSTGRES_USER=sovietgram
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Outgoing transactional email (Brevo SMTP).
# Copy these values to /opt/sovietgram/.env; NEVER commit real credentials.
# The SMTP username is shown under Brevo > SMTP & API > SMTP.
# The SMTP password is an SMTP key, NOT the Brevo account password or API key.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Sovietgram <noreply@sovietgram.su>"
EMAIL_TIMEOUT=15

# Optional override; development defaults to console output, production to SMTP.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
